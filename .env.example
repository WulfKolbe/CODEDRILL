# codedrill / pdfdrill environment — copy to `.env` and fill with your ROTATED keys.
# `.env` is git-ignored. NEVER commit real keys. codedrill loads these from the
# environment only; it makes no paid API calls on your behalf.
#
# The keys originally shared into this build (MathPix, Perplexity, OpenAI, DeepL)
# were exposed in plaintext and must be treated as COMPROMISED — rotate all four
# (revoke the OpenAI project key first, highest blast radius) before using them here.

# --- pdfdrill: MathPix OCR (paid) ---
MATHPIX_APP_ID=your-mathpix-app-id
MATHPIX_APP_KEY=your-mathpix-app-key

# --- optional providers ---
PERPLEXITY_API_KEY=your-perplexity-key
DEEPL_API_KEY=your-deepl-key

# --- codedrill optional LLM edge proposer (OFF by default) ---
# Set CODEDRILL_LLM=1 to enable llm_concepts.propose_edges (type-gated, see README).
CODEDRILL_LLM=0
OPENAI_API_KEY=your-openai-project-key
